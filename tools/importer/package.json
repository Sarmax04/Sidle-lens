{
  "name": "sidle-importer",
  "version": "1.0.0",
  "private": true,
  "description": "Imports furniture models and real-world dimensions into the Sidle Lens catalog. Not part of the Lens.",
  "type": "module",
  "bin": {
    "sidle-import": "./import.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "import": "node --max-old-space-size=8192 import.mjs",
    "thumbnails": "node import.mjs --add-thumbnails",
    "stats": "node stats.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "cheerio": "^1.2.0",
    "fbx2gltf": "^0.9.7-p1",
    "meshoptimizer": "^1.3.0",
    "obj2gltf": "^3.2.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "three": "^0.187.0"
  }
}
