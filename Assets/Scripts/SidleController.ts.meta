  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">SidleController – state, clearance, room</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject room {"hint":"Root of the virtual stand-in room; its origin is the floor under the start position"}'
    - '// @input SceneObject doorway {"hint":"Doorway root (authored at the near wall line)"}'
    - '// @input SceneObject coffeeTable {"hint":"Coffee table root — placed in the far right corner at start"}'
    - '// @input SceneObject pieceRoot {"hint":"Piece root — moved/rotated on the floor; its authored X/Z is the start spot"}'
    - '// @input SceneObject outlineRoot {"hint":"Floor outline root (follows the piece)"}'
    - '// @input AssignableType_1 panelUI {"hint":"Control panel view"}'
    - '// @input AssignableType_2 labelsUI {"hint":"Dimension + gap label view"}'
    - '// @input AssignableType_3 galleryUI {"hint":"Gallery view (Update 4); has its own SidleLazyFollow"}'
    - '// @input Asset.Material litMaterial {"hint":"Lit template material for room + furniture boxes (cloned per color)"}'
    - '// @input Asset.Material unlitMaterial {"hint":"Unlit template material for the floor outline (cloned per color)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Imported pieces"}'
    - '// @input Asset.JsonAsset catalog {"hint":"Bundled Assets/Models/catalog.json"}'
    - '// @input Asset.ObjectPrefab[] modelPrefabs = {} {"hint":"GLB prefabs from Assets/Models; matched to catalog entries by file name"}'
    - '// @input Asset.Texture[] thumbnailTextures = {} {"hint":"Gallery thumbnails from Assets/Models/thumbs; matched to the catalog thumbnail field by file name"}'
    - '// @input bool showPlaceholderPieces = true {"hint":"Offer the built-in box pieces (Sofa A/B, bed, dining table). Off: imported pieces only; falls back to the built-ins if there are none"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Room"}'
    - '// @input float wallHeight = 250 {"hint":"Wall height, cm", "widget":"slider", "min":200, "max":350, "step":5}'
    - '// @input float startInsetCm = 30 {"hint":"How far the doorway wall line is behind the start position, cm", "widget":"slider", "min":10, "max":100, "step":1}'
    - '// @input float doorWidth = 90 {"hint":"Doorway opening width, cm", "widget":"slider", "min":60, "max":140, "step":1}'
    - '// @input float doorHeight = 200 {"hint":"Doorway opening height, cm", "widget":"slider", "min":180, "max":240, "step":1}'
    - '// @input vec4 wallColor = "{0.95, 0.93, 0.88, 1.0}" {"hint":"Wall color: warm white (left, right and doorway walls)", "widget":"color"}'
    - '// @input vec4 floorColor = "{0.95, 0.88, 0.76, 1.0}" {"hint":"Floor color: flat light wood tone (unlit). Kept light so the green/red outline and the gap number read on it", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Room look (Update 7, decoration only)"}'
    - '// @input vec4 accentWallColor = "{0.74, 0.8, 0.7, 1.0}" {"hint":"Accent wall color (the far wall): soft sage", "widget":"color"}'
    - '// @input vec4 plankLineColor = "{0.86, 0.77, 0.63, 1.0}" {"hint":"Thin plank lines on the floor (slightly darker than the floor)", "widget":"color"}'
    - '// @input float plankWidthCm = 20 {"hint":"Plank width, cm (distance between plank lines)", "widget":"slider", "min":10, "max":40, "step":1}'
    - '// @input vec4 baseboardColor = "{0.99, 0.98, 0.96, 1.0}" {"hint":"Baseboard color (lighter than the walls)", "widget":"color"}'
    - '// @input vec4 frameColor = "{0.97, 0.96, 0.93, 1.0}" {"hint":"Window frame and door frame color (light)", "widget":"color"}'
    - '// @input vec4 windowPaneColor = "{0.88, 0.95, 1.0, 1.0}" {"hint":"Window pane color (pale, bright; unlit)", "widget":"color"}'
    - '// @input bool showRug = true {"hint":"Show the flat rug in the middle of the room"}'
    - '// @input vec4 rugColor = "{0.8, 0.85, 0.92, 1.0}" {"hint":"Rug color: soft dusty blue (unlit)", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Clearance"}'
    - '// @input float clearanceCm = 80 {"hint":"Minimum free space to walls, doorway wall and coffee table, cm", "widget":"slider", "min":30, "max":150, "step":1}'
    - '// @input float rotateStepDeg = 15 {"hint":"Rotate button step, degrees", "widget":"slider", "min":5, "max":90, "step":1}'
    - '// @input float gapFadeSeconds = 1 {"hint":"Gap number fade-out time after going green, seconds", "widget":"slider", "min":0.2, "max":3, "step":0.1}'
    - '// @input vec4 clearColor = "{0.35, 0.85, 0.45, 1.0}" {"hint":"Outline color when clear", "widget":"color"}'
    - '// @input vec4 placedOutlineColor = "{0.8, 0.8, 0.8, 1.0}" {"hint":"Outline color of placed pieces (faint, neutral: not green or red)", "widget":"color"}'
    - '// @input vec4 tooCloseColor = "{1.0, 0.3, 0.25, 1.0}" {"hint":"Outline edge color when too close", "widget":"color"}'
    - '// @input float outlineWidthCm = 1.5 {"hint":"Outline line width, cm (thin + faint)", "widget":"slider", "min":0.5, "max":5, "step":0.1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Debug"}'
    - "// @input bool debugColliders {\"hint\":\"Wireframe the piece's grab collider\"}"
    - '// @ui {"widget":"group_end"}'
